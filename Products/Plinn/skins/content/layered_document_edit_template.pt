<html metal:use-macro="here/main_template/macros/master">
  <head>
    <title>Document edit form</title>
    <meta http-equiv="content-type" content="text/html;charset=UTF-8"/>
    <link href="zpt_stylesheet.css" rel="stylesheet" media="screen"/>
  </head>
  <body i18n:domain="plinn">
    <div metal:fill-slot="header">
      <div metal:use-macro="here/widgets/macros/generic_header">
        generic_header macro
      </div>
    </div>

    <div metal:fill-slot="main">
      <div tal:define="filteredActionsList options/layerstabs;
                       forceTab options/selected_tab">
        <div metal:use-macro="here/tabs/macros/standalone_tabs">
          layer selector
        </div>
      </div>
      <form method="post" enctype="multipart/form-data"
               tal:attributes="action options/form/action">
        <article tal:condition="python:options['edit_type']=='layer'">
          <div tal:define="inputname string:text;
                           inputvalue options/layer_html"
               tal:omit-tag="">
            <div metal:use-macro="here/wysiwyg_support/macros/wysiwygEditorBox">
              Wysiwig Code
            </div>
          </div>
          <input name="layer:int" type="hidden"
                 tal:attributes="value options/selected_layer"/>
          <br/>
          <input type="submit" name="save_layer" value="Save" i18n:attributes="value"/>
        </article>

        <div tal:condition="python:options['edit_type'] == 'kinematic'">
          <div tal:define="kopts python:here.getKinematicOptions(asjson=False)"
               tal:omit-tag="">
            <table class="TwoColumnForm">
              <tr>
                <td colspan="2">
                  <h1 i18n:translate="">Background options</h1>
                </td>
              </tr>
              <tr>
                <th i18n:translate="">
                  Stitch background after
                </th>
                <td>
                  <input type="text" name="kopts.stitch_after:record"
                         placeholder="selector"
                         tal:attributes="value kopts/stitch_after|nothing"
                         i18n:attributes="placeholder"/>
                </td>
              </tr>
              <tr>
                <th i18n:translate="">
                  Background scroll speedup
                </th>
                <td>
                  <input type="text" name="kopts.bg_scroll_speedup:record"
                         placeholder="number"
                         tal:attributes="value kopts/bg_scroll_speedup|nothing"
                         i18n:attributes="placeholder"/>
                </td>
              </tr>
              <tr>
                <td colspan="2">
                  <h1 i18n:translate="">Foreground options</h1>
                </td>
              </tr>
              <tr>
                <th i18n:translate="">
                  Initial position
                </th>
                <td>
                  <input type="text" name="kopts.fg_init_position:record"
                         placeholder="css size with unit"
                         tal:attributes="value kopts/fg_init_position|nothing"
                         i18n:attributes="placeholder"/>
                </td>
              </tr>
            </table>
          </div>
          <input type="submit" name="save_options" value="Save" i18n:attributes="value"/>
        </div>
      </form>
    </div>
  </body>
</html>
