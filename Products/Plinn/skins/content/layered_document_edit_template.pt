<html metal:use-macro="here/main_template/macros/master">
  <head>
    <title>Document edit form</title>
    <meta http-equiv="content-type" content="text/html;charset=UTF-8"/>
    <link href="zpt_stylesheet.css" rel="stylesheet" media="screen"/>
  </head>
  <body i18n:domain="plinn">
    <div metal:fill-slot="header">
      <div metal:use-macro="here/widgets/macros/generic_header">
        generic_header macro
      </div>
    </div>

    <div metal:fill-slot="main">
      <div tal:define="filteredActionsList options/layerstabs;
                       forceTab options/selected_tab">
        <div metal:use-macro="here/tabs/macros/standalone_tabs">
          layer selector
        </div>
      </div>
      <form method="post" enctype="multipart/form-data"
               tal:attributes="action options/form/action">
        <div tal:condition="python:options['edit_type']=='layer'"
             tal:omit-tag="">
          <div tal:define="inputname string:text;
                           inputvalue options/layer_html"
               tal:omit-tag="">
            <div metal:use-macro="here/wysiwyg_support/macros/wysiwygEditorBox">
              Wysiwig Code
            </div>
          </div>
          <input name="layer:int" type="hidden"
                 tal:attributes="value options/selected_layer"/>
          <br/>
          <input type="submit" name="save" value="Save" i18n:attributes="value"/>
        </div>

        <div tal:condition="python:options['edit_type'] == 'kinematic'">
          <!-- TODO -->
        </div>
      </form>
    </div>
  </body>
</html>
