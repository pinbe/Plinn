/* global_plinn_style.css */
<dtml-var global_plinn_style.css>

/* personalisation pour l'éditeur
<dtml-with base_properties> */
body {
  margin-top: 16px;
}

/* XXX may be moved to ckeditor */

.captioned-img img,
.captioned-img path {
  transition: all 250ms;
}

.captioned-img svg path {
  fill: #d1d1d1;
}

.captioned-img .dragover path {
  fill: &dtml-outlineColor;;
}

.captioned-img img.dragover {
  opacity: 0.2;
}

.progress-bar {
  display: block;
  position: absolute;
  background: &dtml-outlineColor;;
  height: 4px;
  border-radius: 2px;
  width: 100%;
  left: 0;
  top: 1em
}

.flex, .grid-3-cols {
  border: 1px dotted silver;
}

.slideshow > img {
  position: unset;
  top: unset;
  left: unset;
  transform: unset;
}

.slideshow .error {
  color: #f00;
}

/* CKEditor workarround*/
.cke_widget_captioned_img {
  display: inline-block;
}
/* </dtml-with> */

/* editor css customizations */
<dtml-var editor_style_customizations.css>