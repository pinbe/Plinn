<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">

  <head>
    <meta http-equiv="content-type" content="text/html;charset=UTF-8" />
    <title></title>
  </head>

  <body>

<div metal:define-macro="global_defines" tal:omit-tag=""
tal:define="
global utool nocall:here/portal_url;
global mtool here/portal_membership;
global atool here/portal_actions;
global wtool here/portal_workflow;
global portal_object utool/getPortalObject;
global portal_title portal_object/Title;
global object_title here/title_or_id;
global portal_url utool;
global member mtool/getAuthenticatedMember;
global membersfolder mtool/getMembersFolder;
global isAnon mtool/isAnonymousUser;
global actions python: atool.listFilteredActionsFor( here );
global user_actions actions/user;
global object_actions actions/object;
global workflow_actions actions/workflow;
global folder_actions actions/folder;
global global_actions actions/global;
global wf_state python:wtool.getInfoFor(here,'review_state','');
global locale_date_fmt here/locale_date_fmt;
global dummy python:request.RESPONSE.setHeader('Content-Type', 'text/html;;charset=utf-8');
Iterator python:modules['Products.Plinn'].IndexIterator ;
global tabindex python:Iterator();
global specialCtxHeader options/specialCtxHeader|nothing"
		/>


    <div metal:define-macro="top_bar"
         id="top-bar">
        <a tal:attributes="href portal_url;
                           title portal_object/title_or_id">
          <img id="portal-logo"
               tal:define="logo here/logo.png"
               tal:attributes="src logo/absolute_url;
                               alt portal_object/title_or_id;
                               height logo/height;
                               width logo/width" />
        </a>
      <div id="site-menu"
           tal:define="menu actions/site_menu|nothing"
           tal:condition="menu">

        <a tal:repeat="a menu"
           tal:content="a/title" tal:attributes="href a/url">Site Menu</a>
      </div>
      <div id="user-menu"
           tal:define="uname python:member.getMemberFullName(nameBefore=0) if not isAnon else ''">
        <span>
          <span tal:content="uname">Mâne</span>
          <i class="fa fa-user-circle" style="font-size: 1.5em; padding-bottom: 3px"></i>
          <ul class="hidden">
            <li tal:repeat="action user_actions">
              <a tal:attributes="href action/url"
                 tal:content="action/title">yeah</a>
            </li>
          </ul>
        </span>
      </div>
      <script type="text/javascript">
        (function() {
          d3.select('#user-menu i')
              .on('click',
                function() {
                  var menu = d3.select('#user-menu ul').node();
                  var body = d3.select('body');
                  if(menu.classList.contains('hidden')) {
                    menu.classList.remove('hidden');
                    d3.event.stopPropagation();
                    body.on('click.cancel-user-menu',
                      function() {
                        menu.classList.add('hidden');
                        body.on('click.cancel-user-menu', null);
                      }
                    );
                  }
                }
              )
        }());
      </script>
    </div>

    <div metal:define-macro="site_edit_panel"
         tal:condition="python:member.has_role(['photographe', 'Manager'])"
         tal:omit-tag=""
         i18n:domain="plinn">
      <script type="text/javascript"
              tal:attributes="src string:$portal_url/js/site_panel.js"></script>
      <div id="site-edit-panel"
           tal:define="shift python:300 if request.cookies.get('spo')=='1' else 0"
           tal:attributes="style python:'left: %dpx' % (-300 + shift)">
        <div class="handle">
          <a href="#"
             title="Edit site"
             i18n:attributes="title">
            <i class="fa fa-bars"></i>
          </a>
        </div>
        <div class="content">
          <div tal:define="treeRoot portal_object;
                           treeRootSelector string:#site-edit-panel"
               tal:omit-tag="">
            <div metal:use-macro="here/tree_macros/macros/tree"></div>
          </div>
        </div>
      </div>
      <script type="text/javascript">
        window.addEventListener('load',
          function() {
            new SitePanel('#site-edit-panel', '#body-wrapper');
          }
        );
      </script>

    </div>
  


    <div metal:define-macro="Breadcrumbs" tal:omit-tag="">
      <span tal:content="here/absolute_url" id="BC_Object_URL" style="display:none"></span>
      <span i18n:translate="">You are here:</span> <span tal:omit-tag="" tal:repeat="bc options/breadcrumbs|here/breadcrumbs"><a href="." tal:attributes="href bc/url" tal:content="python:bc['title'] or bc['id']">ID</a><span tal:condition="not: repeat/bc/end" tal:omit-tag=""> / </span> </span>
    </div>


    <div metal:define-macro="leftCell">LeftCell</div>
    <div metal:define-macro="rightCell">rightCell</div>


  </body>

</html>