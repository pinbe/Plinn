<html xmlns="http://www.w3.org/1999/xhtml" tal:omit-tag="">

  <head tal:replace="nothing">
    <meta http-equiv="content-type" content="text/html;charset=UTF-8"/>
    <title>tree_macros</title>
  </head>

  <body>
    <div  metal:define-macro="tree"
             tal:omit-tag=""
             i18n:domain="plinn">
      <div tal:define="
              treeMetaTypes python:['Huge Plinn Folder', 'Portfolio', 'Topic'];
              treeDict   python:portal_object.make_nav_tree(rootObject=treeRoot);
              tree treeDict/tree;
              rows treeDict/rows;
              height tree/height;
              rootNode python:rows.pop(0);
              portal_url here/portal_url"
           tal:condition="rows"
           tal:omit-tag="">

        <div class="tree-view"
             tal:attributes="data-root-id rootNode/id;
                             data-filter python:','.join(treeMetaTypes);
                             data-tree_pre tree/tree_pre">
          <div tal:repeat="row rows"
                   tal:attributes="style python:'padding-left: %dpx' % ((row.depth - 1) * 16 + 5);
                                   data-depth python:row.depth;
                                   data-id row/id"
          ><span tal:define="obj nocall:row/object;
                    rlink row/branch"
                     tal:omit-tag=""
            ><a class="toggle"
                tal:condition="row/state"
                tal:attributes="href rlink/link">
                <i tal:attributes="class python:'fa fa-caret-right %s' %
                                   ('opened' if row.state > 0 else 'closed')"
                ></i></a><i class="sp"
                            tal:condition="not:row/state"
              ></i><img tal:attributes="src obj/getIconURL"
                /><a tal:attributes="href obj/absolute_url;
                      title obj/Description"
                       tal:content="obj/title_or_id"
                  ></a></span>
          </div>
        </div>
      </div>
    </div>
  </body>

</html>
