/* <dtml-with base_properties> */

@font-face {
  font-family: "Coda Caption";
  src: url(<dtml-var portal_url>/fonts/CodaCaption-ExtraBold.ttf);
}

#fixed-content {
  position: fixed;
}

h1, h2, h3, h4, h5, h6 {
  font-size: 18px;
  font-weight: lighter;
  margin: 1em 0 0.5em 0;
}

h1 {
  text-transform: uppercase;
}

h2 {
  font-style: italic;
}

span.half-underline {
  position: relative;
}

span.half-underline::before {
	display: block;
	position: absolute;
	content: "";
	width: 50%;
	left: 25%;
	top: 1.2em;
	border-bottom: 2px solid #484848;
}

article {
  text-align: justify;
  background: &dtml-contentBackgroundColor;;
  min-height: 100vh;
  max-width: 1080px;
}

.layereddocument article {
  margin-top: 480px;
}

.layereddocument article {
  padding: 10px 10px 0 10px;
}

article .flex-wrapper {
  /*border: 1px solid deeppink;*/
  /*display: table;*/
  /*width: 100%;*/

}

article .flex {
  /*border: 1px dashed  darkslateblue;*/
  display: flex;
  flex-wrap: wrap;
  /*vertical-align: top;*/
  /*text-align: left;*/
  /*width: -moz-fit-content;*/
  /*width: -webkit-fit-content;*/
  /*width: fit-content;*/
}


article .img-grid {
  text-align: center;
  max-width: 1200px;
  margin: 0 auto;
}

article .img-grid img {
  margin: 0 15px 15px 0;
  display: inline-block;
  height: 270px;
  width: auto;
}

article .captioned-img {
  display: inline-block;
  margin: 0 15px 15px 0;
  width: 400px;
  height: 350px;
}

article .captioned-img img {
  width: 400px;
  height: auto;
}

article .captioned-img h1 {
  font-weight: bold;
  text-transform: none;
  margin: 0;
}



.rounded-corners {
  border-radius: &dtml-borderRadius;px;
  padding: &dtml-borderRadius;px;
}

.std-border {
  border: &dtml-tabsBorderWidth; solid &dtml-tabsBorderColor;;
}

.std-background {
  color: #fff;
  padding: &dtml-borderRadius;px;
  background: &dtml-outlineColor;;
}

.std-background a,
.std-background a:link,
.std-background a:visited,
.std-background a:active {
  color:#ae1b1b;
}

.std-background a:hover {
  color:#f40909;
}

.std-focusbox {
  background: &dtml-tabsBorderColor;;
  color: &dtml-tabsFontColor;;
  padding: &dtml-borderRadius;px;
}

.std-focusbox a,
.std-focusbox a:link,
.std-focusbox a:visited,
.std-focusbox a:active {
  color:#f28c18;
}

.std-focusbox a:hover {
  color:#f2ae61;
}

.letter-spacing-plus {
  letter-spacing: 0.4em;
}

.coda {
  font-family: 'Coda Caption', sans-serif;
}
/*</dtml-with> */