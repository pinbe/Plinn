/* <dtml-with base_properties> */
#site-edit-panel {
  position: fixed;
  /*width: 100px;*/
  height: 100vh;
  background: #484848;
}

#site-edit-panel > .handle {
  position: absolute;
  right: -35px;
  font-size: 35px;
}

#site-edit-panel > .handle a,
#site-edit-panel > .handle a {
  color: &dtml-highLightColor;;
}

/* </dtml-with> */