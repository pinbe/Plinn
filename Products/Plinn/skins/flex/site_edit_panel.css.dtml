/* <dtml-with base_properties> */
#site-edit-panel {
  position: fixed;
  width: 300px;
  left: -300px;
  height: 100vh;
  background: #484848;
  padding: 5px;
}

#site-edit-panel > .handle {
  position: absolute;
  right: -35px;
  font-size: 35px;
}

#site-edit-panel > .handle a,
#site-edit-panel > .handle a:hover {
  color: &dtml-highLightColor;;
}

#site-edit-panel a {
  color: &dtml-sitePanelLinkColor;;
}

#site-edit-panel a:hover {
  color: &dtml-sitePanelLinkHoverColor;;
}

/* </dtml-with> */