<metal:block define-macro="master">
  <tal:block define="global main_macros here/main_template_macros/macros"/>
  <metal:block use-macro="main_macros/global_defines"/>
  <!DOCTYPE html>

  <html>

    <head>
      <title tal:content="here/expanded_title">Title goes here</title>

      <meta http-equiv="content-type" content="text/html;charset=utf-8" />
      <meta name="description"
            tal:attributes="content python:here.Description().strip() or portal_object.description" />
      <meta name="keywords"
            tal:define="keywords python:here.Subject() or portal_object.keywords or []"
            tal:attributes="content python:', '.join(keywords)" />
      <meta name="viewport" content="width=device-width, initial-scale=1">
      <metal:block metal:define-slot="meta"></metal:block>
      <base tal:omit-tag="" metal:define-slot="base" />

      <link rel="canonical"
            tal:condition="python:here.getPortalTypeName() != 'CMF Site'"
            tal:define="canonical python:here.absolute_url().rstrip('/')"
            tal:attributes="href python: canonical if not canonical.endswith('/index_html') else canonical[:-len('/index_html')]"/>

      <link rel="icon" type="image/png" href="favicon.ico" tal:attributes="href string:$portal_url/favicon.png" />
      <metal:block metal:define-slot="analytics-slot">
        <tal:block tal:define="analytics_template nocall:here/analytics_template|nothing">
          <tal:block tal:condition="analytics_template">
            <metal:block metal:use-macro="analytics_template/macros/main"></metal:block>
          </tal:block>
        </tal:block>
      </metal:block>
      <link rel="stylesheet" media="screen" tal:attributes="href here/global_plinn_style.css/absolute_url" />
      <link rel="stylesheet" media="screen" tal:attributes="href string:${portal_url}/css/font-awesome.min.css" />
      <style type="text/css" media="all" tal:content="string:@import url(${here/calendar-system.css/absolute_url});"></style>

      <link metal:define-slot="css_slot" tal:replace="nothing" />
      <script type="text/javascript"
              tal:attributes="src string:$portal_url/js/d3.min.js"></script>
      <script type="text/javascript"
              tal:attributes="src string:$portal_url/js/utils.js"></script>
      <script type="text/javascript"
              tal:attributes="src string:$portal_url/js/base_properties.js"></script>
      <script type="text/javascript"
              tal:attributes="src string:$portal_url/js/main_layout.js"></script>
      <script type="text/javascript"
              tal:attributes="src string:$portal_url/js/script_loader.js"></script>
      <script type="text/javascript"
              tal:attributes="src string:$portal_url/js/fragment_importer.js"></script>
      <script type="text/javascript"
              tal:attributes="src string:$portal_url/js/ajax_form_manager.js"></script>

      <script type="text/javascript" metal:define-slot="javascript_head_slot" tal:replace="nothing"></script>
      <tal:block tal:replace="structure python:modules['Products.Plinn.utils'].getLdJson(here)"></tal:block>
    </head>
    <body tal:attributes="data-portal_url portal_url;
                          data-absolute_url here/absolute_url;
                          data-isAnon python:not not isAnon;
                          class python:'pt-%s' % here.getPortalTypeName().replace(' ', '-').lower()">
      <div id="site-edit-panel"
           metal:use-macro="main_macros/site_edit_panel"></div>
      <div id="fixed-content">
        <div metal:define-slot="fixed_content_top"></div>
      </div>
      <div id="body-wrapper"
           metal:define-slot="body"
           tal:define="isManager python:member.has_role(['photographe', 'Manager']);
                       shift python:300 if request.cookies.get('spo')=='1' else 0"
           tal:attributes="style python:'margin-left: %(shift)dpx;; width: calc(100vw - %(shift)dpx);;' % {'shift':shift} if
                  isManager else None">
        <div id="top-bar"
             metal:use-macro="here/topbar_macros/macros/top_bar">top bar</div>
        <div id="content-outer">
          <div id="content-wrapper" tal:attributes="class content_wrapper_class|nothing">
            <div metal:define-slot="main_no_tabs" tal:omit-tag="">
              <div class="edit-controls">
                <div tal:condition="specialCtxHeader" tal:content="structure specialCtxHeader">special context header</div>
                <div tal:condition="not:specialCtxHeader" tal:omit-tag="">
                  <div class="tabs" metal:use-macro="here/tabs/macros/tabs">Content tabs</div>
                  <div metal:use-macro="here/tabs/macros/additional_tabs">Additional tabs</div>
                </div>
              </div>
              <div tal:omit-tag="" metal:define-slot="header"></div>
              <div metal:define-slot="main" tal:omit-tag="">main</div>
              <div metal:define-slot="footer" tal:replace="nothing">footer slot</div>
            </div>
            <div id="main-footer" metal:define-slot="main_footer">
              <div tal:replace="structure here/main_footer/EditableBody"
                   tal:on-error="string:">Footer content</div>
            </div>
          </div>
        </div>
      </div>
    </body>
  </html>
</metal:block>