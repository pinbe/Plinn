/* Photo / Portfolio */
.slide {
  height : &dtml-slide_size;px ;
  width : &dtml-slide_size;px ;
  float : left ;
  border : 1px solid black ;
  margin-top : -1px ;
  margin-left : -1px ;
  text-align : center ;
  background-color : #fff ;
  overflow : auto ;
}
/* </dtml-with> */
