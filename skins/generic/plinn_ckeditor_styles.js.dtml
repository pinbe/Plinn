CKEDITOR.stylesSet.add( 'plinn_styles', [
    { name: 'Bloc arrondi',
      element: 'div',
      attributes : {'class' : 'rounded-corners'}
    },
    { name: 'Cellule arrondie',
      element: 'td',
      attributes : {'class' : 'rounded-corners'}
    },
    { name: 'Image arrondie',
      element: 'img',
      attributes : {'class' : 'rounded-corners'}
    },

]);
